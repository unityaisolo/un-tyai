# Sunucu
PORT=8787

# Anahtar kasası şifreleme anahtarı (32 byte, base64). Üretimde gizli tutun.
KEYVAULT_SECRET=change-me-32-byte-base64-secret==

# Bizim havuz anahtarlarımız (kullanıcı BYO-key vermezse kullanılır)
# EN AZINDAN GROQ_API_KEY doldur — varsayılan beyin (nova-flash) Groq'ta çalışır.
GROQ_API_KEY=
# OpenRouter: ücretsiz model fallback zinciri için (nova-openrouter, meta-llama/* vb.)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# White-label alias'ların arkasındaki modeller (boşsa aliases.ts varsayılanları geçerli)
# nova-flash: ana beyin. Groq'taki model emekli olursa buradan güncelle.
NOVA_FLASH=
# nova-vision: görsel okuma (chat'e eklenen görseller + world/review)
NOVA_VISION=
# Council denetçi modeli (boşsa beynin modeli kullanılır — Ollama testinde anahtar gerekmez)
COUNCIL_AUDITOR=

# fal.ai (3D/görsel üretim)
FAL_KEY=
# 3D model seçimi modaliteye göre yapılır (varsayılanlar Tripo v2.5 - ucuz & tutarlı):
#   metinden 3D  -> tripo3d/tripo/v2.5/text-to-3d
#   görselden 3D -> tripo3d/tripo/v2.5/image-to-3d
# İstersen değiştir:
FAL_3D_TEXT_MODEL=tripo3d/tripo/v2.5/text-to-3d
FAL_3D_IMAGE_MODEL=tripo3d/tripo/v2.5/image-to-3d
# Tripo doku kalitesi: no | standard | HD  (HD daha pahalı)
FAL_3D_TEXTURE=standard
# İş başına yaklaşık maliyet (metering için). Tripo standard ~0.30
FAL_3D_COST=0.30
# Tek bir endpoint'e zorlamak istersen (ör. Rodin ikisini de destekler) bunu ayarla:
# FAL_3D_MODEL=fal-ai/hyper3d/rodin

# Karakter hatti (rig + animasyon) fal uzerinden calisir -> ekstra anahtar GEREKMEZ.
# fal-ai/meshy/rigging, FAL_KEY ile ayni anahtari kullanir.
FAL_RIG_COST=0.15
FAL_ANIM_COST=0.10
# Metinden görsel (görselden-3D için kaynak). Varsayılan: fal-ai/flux/schnell
FAL_IMAGE_MODEL=
FAL_IMAGE_COST=0.01
# (Opsiyonel) Alternatif olarak Tripo-direct kullanmak istersen:
# TRIPO_API_KEY=

# Ollama (yerel model) sunucu adresi
OLLAMA_HOST=http://localhost:11434
# GPU sorunu varsa CPU'ya zorlamak için 0 yap
OLLAMA_NUM_GPU=

# Komisyon oranı (bizim havuz kullanıldığında token maliyetine eklenir)
COMMISSION_RATE=0.20

# Erişim kilidi (opsiyonel): doldurulursa yalnız listedeki Bearer token'lar kabul edilir.
# Biçim: "token1:kullanici1,token2:kullanici2" (userId verilmezse token'ın kendisi userId olur)
# Boş bırakılırsa herkese açık dev modu (token = userId, yoksa "demo-user").
API_TOKENS=

# Dakika başına istek limiti (kullanıcı+IP başına, in-memory). 0 = kapalı.
RATE_LIMIT_PER_MIN=60

# Ödeme (Faz 5 — MoR: Polar.sh/Paddle; Stripe Türkiye'de yok)
# POLAR_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# ASSET DAĞITIMI (beta) — plugin model kütüphanesini buluttan indirir.
# Kullanıcı paketi GitHub URL'i ile ekler; paketin içinde model YOKTUR.
# catalog.json bir kez, GLB'ler talep üzerine (lazy) indirilir.
# Firebase Storage örneği:
#   https://firebasestorage.googleapis.com/v0/b/<bucket>/o/catalog.json?alt=media
# ─────────────────────────────────────────────────────────────────────────────
# catalog.json'un tam URL'i
# Bunları BOŞ BIRAKABİLİRSİN — Nova'nın kendi bulut adresleri koda gömülüdür.
# Yalnızca kendi depolamanı (R2/S3/başka bir Firebase) kullanacaksan doldur.
NOVA_ASSET_CATALOG_URL=
# GLB kökü — dosya adı doğrudan sonuna eklenir (sonda / olsun)
NOVA_ASSET_BASE_URL=
# Opsiyonel: textures-raw paketinin zip URL'i (yoksa arazi düz renk katman kullanır)
NOVA_TEXTURES_ZIP_URL=
# Opsiyonel sürüm etiketi
NOVA_ASSET_VERSION=1

# ─────────────────────────────────────────────────────────────────────────────
# ANAHTAR MODU  (2026-07 mimari kararı)
#
# Varsayılan: BYO ZORUNLU. Her kullanıcı kendi API anahtarını Unity'deki
# Ayarlar sekmesinden girer. Anahtar KULLANICININ kendi makinesinde,
# ~/.nova/vault.json içinde AES-256-GCM ile şifreli durur. Ağa çıkmaz.
#
# Aşağıdaki havuz anahtarları YALNIZCA ALLOW_POOL_KEYS=true iken kullanılır.
# ⚠ BU DOSYAYI VE .env'i ASLA DAĞITMA/COMMIT ETME. Ücretli kullanıcılara
#   hizmet verecekseniz havuz anahtarları yalnızca SİZİN sunucunuzun
#   ortam değişkenlerinde bulunmalı; istemciye hiçbir uç anahtar döndürmez.
ALLOW_POOL_KEYS=

# Anahtar kasası şifreleme sırrı. Boş bırakılırsa ilk çalıştırmada rastgele
# üretilip ~/.nova/vault.key içine 0600 izniyle yazılır (önerilen).
# Elle verirsen en az 16 karakter olmalı.
KEYVAULT_SECRET=

# Kasa/veri dizini (varsayılan: ~/.nova)
NOVA_DATA_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# NOVA CLOUD (üyelik + kredi) — YALNIZCA senin bulut sunucunda true olmalı.
# Yerel kurulumda boş bırak: kredi kapısı devre dışı kalır, kullanıcı kendi
# anahtarıyla serbest çalışır.
# ─────────────────────────────────────────────────────────────────────────────
NOVA_CLOUD=

# Firebase kimlik doğrulama (bulut modunda zorunlu). Sadece proje kimliği yeterli;
# servis hesabı anahtarı GEREKMEZ — ID token Google'ın açık sertifikalarıyla
# doğrulanır (ek npm paketi de yok).
FIREBASE_PROJECT_ID=

# Kredi/üyelik verme sırrı. Ödeme webhook'u bu başlıkla çağırır:
#   POST /v1/account/grant   x-admin-secret: <bu değer>
# Boş bırakılırsa kredi verme ucu tamamen kapalıdır.
ADMIN_SECRET=

# Yeni kullanıcıya otomatik verilecek deneme kredisi (1000 kredi = 1 USD). 0 = kapalı.
SIGNUP_BONUS_CREDITS=
